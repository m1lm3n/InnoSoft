ignore-unknown-option data-ciphers
setenv UV_ID a070487b3fc54fc0bdd57acd650b16e6
setenv UV_NAME radium-6862
client
dev tun
dev-type tun
remote md2.unikey.cloud 39212 udp
nobind
persist-tun
cipher AES-128-CBC
data-ciphers AES-128-GCM:AES-128-CBC
auth SHA1
verb 4
mute 4
push-peer-info
ping 10
ping-restart 60
hand-window 70
server-poll-timeout 4
reneg-sec 2592000
sndbuf 393216
rcvbuf 393216
remote-cert-tls server
ignore-unknown-option block-outside-dns
