@page "/domains"
@rendermode InteractiveServer
@using AdAudit.Data
@using AdAudit.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject DomainAdminService Admin
@inject DomainConnectionTester Tester

<PageTitle>Domains & credentials</PageTitle>

<h1>Domains &amp; credentials</h1>

<p class="sub">
    Domains and their collection credentials, backed by cfg.Targets/
    cfg.DomainCredentials - replaces the old targets.psd1 + per-domain
    DPAPI .cred.xml files. Every add/edit/delete is written to the audit
    log. Passwords are write-only: a saved password is never redisplayed,
    only replaced.
</p>

@if (_targets is null)
{
    <p>Loading...</p>
}
else
{
    @if (_editing is null)
    {
        <button class="btn btn-primary mb-3" @onclick="StartAdd">Add domain</button>

        <table class="table">
            <thead>
                <tr>
                    <th>Domain</th>
                    <th>Server</th>
                    <th>Trusted</th>
                    <th>Credential</th>
                    <th>Note</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in _targets)
                {
                    <tr>
                        <td>@t.Domain</td>
                        <td>@t.Server</td>
                        <td>@(t.Trusted ? "Yes" : "No (NTLM/TrustedHosts)")</td>
                        <td>@(t.Credential is not null ? $"Yes ({t.Credential.Username})" : "None")</td>
                        <td>@t.Note</td>
                        <td>
                            <button class="btn btn-sm btn-secondary" @onclick="() => StartEdit(t)">Edit</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(t)">Delete</button>
                        </td>
                    </tr>
                }
                @if (_targets.Count == 0)
                {
                    <tr><td colspan="6" class="sub">No domains yet - click "Add domain" to create one.</td></tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <EditForm Model="_editing" OnValidSubmit="SaveAsync">
            <div class="mb-3">
                <label>Domain (e.g. a.lo)</label>
                <input class="form-control" @bind="_editing.Domain" disabled="@(_editing.Id is not null)" />
            </div>
            <div class="mb-3">
                <label>Primary DC server</label>
                <input class="form-control" @bind="_editing.Server" />
            </div>
            <div class="mb-3">
                <label>
                    <input type="checkbox" @bind="_editing.Trusted" />
                    Trusted (AD trust exists to the management domain - unchecked needs NTLM/TrustedHosts)
                </label>
            </div>
            <div class="mb-3">
                <label>Extra DCs (comma-separated, optional)</label>
                <input class="form-control" @bind="_editing.ExtraServersText" />
            </div>
            <div class="mb-3">
                <label>Note (optional)</label>
                <input class="form-control" @bind="_editing.Note" />
            </div>

            <hr />

            <div class="mb-3">
                <label>Credential username</label>
                <input class="form-control" @bind="_editing.Username" placeholder="e.g. DOMAIN\svc-audit or svc-audit@a.lo" />
            </div>
            <div class="mb-3">
                <label>Credential password</label>
                <input type="password" class="form-control" @bind="_editing.Password"
                       placeholder="@(_editing.Id is not null && _editing.HasExistingCredential ? "leave blank to keep the existing password" : "")" />
            </div>

            <div class="mb-3 d-flex gap-2 align-items-center">
                <button type="button" class="btn btn-outline-secondary" @onclick="TestConnectionAsync" disabled="@_testing">
                    @(_testing ? "Testing..." : "Test connection")
                </button>
                @if (_testResult is not null)
                {
                    <span class="@(_testSuccess ? "text-success" : "text-danger")">@_testResult</span>
                }
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
            </div>
        </EditForm>
    }
}

@code {
    private List<Target>? _targets;
    private EditModel? _editing;
    private bool _testing;
    private bool _testSuccess;
    private string? _testResult;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _targets = await Admin.ListAsync();
    }

    private void StartAdd()
    {
        _editing = new EditModel { Trusted = true };
        _testResult = null;
    }

    private void StartEdit(Target t)
    {
        _editing = new EditModel
        {
            Id = t.Id,
            Domain = t.Domain,
            Server = t.Server,
            Trusted = t.Trusted,
            Note = t.Note,
            ExtraServersText = string.Join(", ", t.ExtraServers.Select(e => e.ServerName)),
            Username = t.Credential?.Username ?? "",
            HasExistingCredential = t.Credential is not null,
        };
        _testResult = null;
    }

    private void CancelEdit()
    {
        _editing = null;
        _testResult = null;
    }

    private async Task SaveAsync()
    {
        if (_editing is null) return;

        var extraServers = _editing.ExtraServersText
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        var actor = await GetActorAsync();
        var targetId = await Admin.SaveTargetAsync(
            _editing.Id, _editing.Domain, _editing.Server, _editing.Trusted, _editing.Note,
            extraServers, actor);

        if (!string.IsNullOrWhiteSpace(_editing.Password))
        {
            await Admin.SetCredentialAsync(targetId, _editing.Username, _editing.Password, actor);
        }

        _editing = null;
        await LoadAsync();
    }

    private async Task DeleteAsync(Target t)
    {
        await Admin.DeleteAsync(t.Id, await GetActorAsync());
        await LoadAsync();
    }

    private async Task TestConnectionAsync()
    {
        if (_editing is null) return;

        // Test whatever password is in hand right now: the freshly-typed
        // one if the field isn't blank, otherwise decrypt the already-saved
        // credential server-side - never sent to the browser either way.
        _testing = true;
        _testResult = null;
        StateHasChanged();

        try
        {
            string? password = _editing.Password;
            if (string.IsNullOrEmpty(password) && _editing.Id is { } id)
            {
                // Decrypting the already-saved credential can fail for
                // reasons that have nothing to do with the domain itself -
                // e.g. this backend process isn't running as the Windows
                // identity the Data Protection keyring is scoped to - and
                // that must show up as a normal failed-test message, not
                // crash the whole Blazor circuit.
                password = await Admin.GetStoredPasswordAsync(id);
            }

            if (string.IsNullOrEmpty(_editing.Server) || string.IsNullOrEmpty(_editing.Username) || string.IsNullOrEmpty(password))
            {
                _testSuccess = false;
                _testResult = "Server, username and password are all required to test.";
                return;
            }

            // Cooldown is keyed by target id; a brand-new (unsaved) domain
            // has none yet, so a random id per attempt is fine - it only
            // needs to be stable for an existing target being retested
            // repeatedly.
            var cooldownKey = _editing.Id ?? Guid.NewGuid();
            (_testSuccess, _testResult) = await Tester.TestAsync(cooldownKey, _editing.Server, _editing.Username, password);
        }
        catch (Exception ex)
        {
            _testSuccess = false;
            _testResult = $"Test failed: {ex.Message}";
        }
        finally
        {
            _testing = false;
        }
    }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    /// <summary>The signed-in Windows account (Negotiate), not the process's own identity - <see cref="Environment.UserName"/> would report svc_adaudit/whatever ran the backend for every entry, defeating the point of an audit log.</summary>
    private async Task<string> GetActorAsync()
    {
        if (AuthStateTask is null) return "unknown";
        var state = await AuthStateTask;
        return state.User.Identity?.Name ?? "unknown";
    }

    private sealed class EditModel
    {
        public Guid? Id { get; set; }
        public string Domain { get; set; } = "";
        public string Server { get; set; } = "";
        public bool Trusted { get; set; } = true;
        public string? Note { get; set; }
        public string ExtraServersText { get; set; } = "";
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
        public bool HasExistingCredential { get; set; }
    }
}
