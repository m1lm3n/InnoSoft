@page "/collect"
@rendermode InteractiveServer
@using AdAudit.Shared.Collection
@using AdAudit.Web.Services
@inject CollectionBroadcastService Broadcast
@implements IDisposable

<PageTitle>Run collection</PageTitle>

<h1>Run collection</h1>

<p class="sub">
    First slice of the background-job mechanism: click Run, watch
    run-remote.ps1's output stream in live, in the browser, from a child
    process launched by the backend. No domain picker or database-backed
    target list yet - just proving the plumbing end to end.
</p>

<div class="mb-3 d-flex gap-2 align-items-center">
    <input class="form-control" style="max-width:16rem" @bind="_domain" placeholder="domain, e.g. a.lo" disabled="@IsRunning" />
    <button class="btn btn-primary" @onclick="StartAsync" disabled="@(IsRunning || string.IsNullOrWhiteSpace(_domain))">
        @(IsRunning ? "Running..." : "Run")
    </button>
    @if (_status is not null)
    {
        <span class="badge @StatusBadgeClass">@_status</span>
    }
</div>

<pre class="p-3 bg-dark text-light" style="min-height:20rem;max-height:32rem;overflow-y:auto;font-size:0.85rem;">@LogText</pre>

@code {
    private string _domain = "a.lo";
    private readonly List<CollectionJobLine> _lines = new();
    private CollectionJob? _job;
    private string? _status;

    private bool IsRunning => _job is not null && _status is null;

    private string LogText => string.Join('\n', _lines.Select(l =>
        (l.IsError ? "[err] " : "") + $"[{l.Timestamp:HH:mm:ss}] " + l.Text));

    private string StatusBadgeClass => _status switch
    {
        "Completed" => "bg-success",
        "Failed" => "bg-danger",
        "Killed" => "bg-warning",
        _ => "bg-secondary",
    };

    private Task StartAsync()
    {
        _lines.Clear();
        _status = null;

        // In-process subscription, not a SignalR client: this component
        // already runs server-side in the same process as the job, so
        // there is no reason to loop a self-referential connection back
        // through the hub just to observe its own job. The hub (see
        // CollectionBroadcastService/CollectionHub) still broadcasts every
        // line regardless, for any other tab/user/future client watching
        // the same job by id - this page just doesn't need to be one of
        // them to see its own output.
        _job = Broadcast.StartJob(_domain);

        _job.LineReceived += OnLine;
        _ = _job.Completion.ContinueWith(_ => InvokeAsync(() =>
        {
            _status = _job.Status.ToString();
            StateHasChanged();
        }), TaskScheduler.Default);

        return Task.CompletedTask;
    }

    private void OnLine(CollectionJobLine line)
    {
        InvokeAsync(() =>
        {
            _lines.Add(line);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        if (_job is not null) _job.LineReceived -= OnLine;
    }
}
